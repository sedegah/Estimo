{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estimo-api",
  "main": "index.ts",
  "compatibility_date": "2026-11-16",
  "observability": {
    "enabled": true
  },
  // Secrets (CLERK_PUBLISHABLE_KEY, DB_PEPPER) live in Worker secrets, not here.
  // ADMIN_* vars are maintained in the dashboard; keep_vars preserves them on deploy.
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estimo",
      "database_id": "25bc7827-39e5-455f-a19a-1f08e4a0c1d9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "estimo-materials"
    }
  ]
  // Once estimo.live is a zone in this account, add its custom domain here:
  // "routes": [{ "pattern": "api.estimo.live", "custom_domain": true }]
}
