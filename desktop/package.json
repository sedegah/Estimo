{
  "name": "estimo-admin-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "ESTIMO Admin - catalogue and price console",
  "author": "ESTIMO",
  "main": "main.js",
  "scripts": {
    "vendor:admin": "node scripts/vendor-admin.mjs",
    "start": "electron .",
    "dist": "npm run vendor:admin && node scripts/patch-nsis.mjs && electron-builder --win nsis",
    "dist:dir": "npm run vendor:admin && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.estimo.admin",
    "productName": "ESTIMO Admin",
    "copyright": "ESTIMO",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/admin",
        "to": "admin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ESTIMO-Admin-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ESTIMO Admin",
      "uninstallDisplayName": "ESTIMO Admin",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "license": "build/LICENSE.txt",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
