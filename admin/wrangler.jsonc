{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estimo-console-k7m2q9",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_ESTIMO_API_URL": "https://estimo-api.sedegahkimathi.workers.dev"
  },
  "preview_urls": false,
  "workers_dev": true
}
