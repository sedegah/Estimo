{
  "name": "estimo",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/estimate-model.test.ts tests/storage-reset.test.ts tests/catalogue-prices.test.ts tests/quantity-engine.test.ts tests/estimate-consistency.test.ts tests/estimate-snapshot.test.ts",
    "test:integration": "node tests/integration.mjs",
    "worker:dev": "npx -y wrangler@latest dev --config worker/wrangler.toml",
    "worker:deploy": "npx -y wrangler@latest deploy --config worker/wrangler.toml",
    "worker:tail": "npx -y wrangler@latest tail estimo-monthly-email",
    "worker:api:dev": "npx -y wrangler@latest dev --config worker/api/wrangler.toml",
    "worker:api:deploy": "npx -y wrangler@latest deploy --config worker/api/wrangler.toml",
    "prices:build": "node tools/apply-supplier-prices.mjs",
    "prices:apply": "node tools/apply-catalogue-prices.mjs",
    "console:build": "npm --prefix admin run build",
    "console:deploy": "npm --prefix admin run deploy",
    "quantities:verify": "tsx tools/verify-quantity-engine.mts",
    "rules:validate": "python tools/validate-rulebook.py"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
